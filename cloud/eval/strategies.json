{
  "comment": "Strategy presets for the search lab. Chunking and aggregation fields map 1:1 onto cloud/src/chunking.ts and cloud/src/semantic-core.ts, so a preset that wins here can be promoted to wrangler.jsonc unchanged.",
  "presets": {
    "note-level-bge": {
      "note": "Approximates the pre-change behaviour: one big chunk per note.",
      "model": "@cf/baai/bge-m3",
      "chunking": { "targetChars": 2000, "maxChars": 4000, "maxLines": 12, "overlapLines": 0, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-bge": {
      "note": "Default line-window chunking with title context.",
      "model": "@cf/baai/bge-m3",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-bge-no-title": {
      "note": "Same chunk shape without the title prefix, to measure title context.",
      "model": "@cf/baai/bge-m3",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": false },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "single-line-bge": {
      "note": "One logical line per chunk: the most precise anchor, least context.",
      "model": "@cf/baai/bge-m3",
      "chunking": { "targetChars": 60, "maxChars": 400, "minChars": 0, "maxLines": 1, "overlapLines": 0, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "wide-bge": {
      "note": "Paragraph-sized windows, to see how much context helps recall.",
      "model": "@cf/baai/bge-m3",
      "chunking": { "targetChars": 500, "maxChars": 800, "maxLines": 6, "overlapLines": 2, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-qwen3": {
      "note": "Qwen3 embedding with its default retrieval instruction.",
      "model": "@cf/qwen/qwen3-embedding-0.6b",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-qwen3-bilingual": {
      "note": "Qwen3 with an instruction that names the cross-language requirement.",
      "model": "@cf/qwen/qwen3-embedding-0.6b",
      "instruction": "Given a search query in any language, retrieve note lines with the same meaning, including lines written in a different language",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "single-line-qwen3": {
      "note": "Qwen3 with one logical line per chunk.",
      "model": "@cf/qwen/qwen3-embedding-0.6b",
      "chunking": { "targetChars": 60, "maxChars": 400, "minChars": 0, "maxLines": 1, "overlapLines": 0, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-gemma": {
      "note": "EmbeddingGemma line windows with calibrated short-query same-chunk consensus.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "lines-gemma-raw": {
      "note": "Control: current primary 0.3/0.6 thresholds without short-query rescue.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 },
      "shortQueryRescue": { "enabled": false }
    },
    "lines-gemma-low-floor": {
      "note": "Noise control: globally lower the primary floor instead of requiring consensus.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.235, "relativeMinRatio": 0.6 },
      "shortQueryRescue": { "enabled": false }
    },
    "lines-gemma-consensus-loose": {
      "note": "Calibration-only looser consensus gates; never promote without negative discipline.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 },
      "shortQueryRescue": { "enabled": true, "rawMinCosine": 0.23, "expandedMinCosine": 0.29 }
    },
    "lines-gemma-consensus-strict": {
      "note": "Calibration-only stricter consensus gates for precision comparison.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 },
      "shortQueryRescue": { "enabled": true, "rawMinCosine": 0.24, "expandedMinCosine": 0.31 }
    },
    "lines-gemma-no-title": {
      "note": "Measures how much the title prefix contributes for EmbeddingGemma.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 220, "maxChars": 400, "maxLines": 3, "overlapLines": 1, "titleContext": false },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "single-line-gemma": {
      "note": "One logical line per chunk with EmbeddingGemma.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 60, "maxChars": 400, "minChars": 0, "maxLines": 1, "overlapLines": 0, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "wide-gemma": {
      "note": "Paragraph-sized windows with EmbeddingGemma.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 500, "maxChars": 800, "maxLines": 6, "overlapLines": 2, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    },
    "tight-gemma": {
      "note": "Two-line windows: a compromise between anchor precision and context.",
      "model": "@cf/google/embeddinggemma-300m",
      "chunking": { "targetChars": 140, "maxChars": 400, "maxLines": 2, "overlapLines": 1, "titleContext": true },
      "aggregation": { "minCosine": 0.3, "relativeMinRatio": 0.6 }
    }
  }
}
