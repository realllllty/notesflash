      "scenario": "number-cross-language",
      "requiredRank": 1,
      "expect": [{ "key": "pricing", "lineIncludes": "$0.012 per million input tokens" }]
    },
    {
      "query": "索引数量和数据库不一致怎么办",
      "scenario": "single-relevant-line",
      "requiredRank": 1,
      "expect": [
        { "key": "long-ops", "lineIncludes": "向量数量少于数据库记录数" },
        { "key": "embedding-en", "lineIncludes": "lower vector count" }
