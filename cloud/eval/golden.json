      "requiredRank": 1,
      "expect": [{ "key": "cost-control", "lineIncludes": "缓存起来可以显著降低推理开销" }]
    },
    {
      "query": "如何降低 AI 调用开销",
      "scenario": "conceptual-zh",
      "requiredRank": 1,
      "expect": [{ "key": "cost-control", "lineIncludes": "缓存起来可以显著降低推理开销" }]
