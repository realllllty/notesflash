{
  "name": "legacy-search-regression-v1",
  "frozen": false,
  "comment": "Legacy regression cases retained for behavior comparison. Some intentionally contain literal distractors and therefore must not be used for lexical-first model or threshold calibration. Expectations reference note keys plus a substring of the expected line.",
  "queries": [
    {
      "query": "迁移",
      "scenario": "cross-language-zh-to-en",
      "requiredRank": 3,
      "expect": [{ "key": "migrate-en", "lineIncludes": "migrate the legacy notes" }],
      "forbid": ["migrate-distractor"]
    },
    {
      "query": "数据迁移方案",
      "scenario": "cross-language-zh-to-en",
      "requiredRank": 1,
      "expect": [{ "key": "migrate-en", "lineIncludes": "migrate the legacy notes" }]
    },
    {
      "query": "deploy",
      "scenario": "cross-language-en-to-zh",
      "requiredRank": 3,
      "expect": [{ "key": "deploy-zh", "lineIncludes": "部署前先执行远程 migration" }]
    },
    {
      "query": "how do I deploy a new version",
      "scenario": "cross-language-en-to-zh",
      "requiredRank": 1,
      "expect": [{ "key": "deploy-zh", "lineIncludes": "部署前先执行远程 migration" }]
    },
    {
      "query": "配对码有效期",
      "scenario": "cross-language-zh-to-en",
      "requiredRank": 1,
      "expect": [{ "key": "pairing-en", "lineIncludes": "pairing code expires after ten minutes" }]
    },
    {
      "query": "trash retention period",
      "scenario": "cross-language-en-to-zh",
      "requiredRank": 1,
      "expect": [{ "key": "trash-zh", "lineIncludes": "回收站保留三十天" }]
    },
    {
      "query": "回收站保留多久",
      "scenario": "same-language-zh",
      "requiredRank": 1,
      "expect": [{ "key": "trash-zh", "lineIncludes": "回收站保留三十天" }]
    },
    {
      "query": "向量索引什么时候要重建",
      "scenario": "cross-language-zh-to-en",
      "requiredRank": 1,
      "expect": [{ "key": "embedding-en", "lineIncludes": "Rebuild the index whenever" }]
    },
    {
      "query": "vector index coverage broken",
      "scenario": "same-language-en",
      "requiredRank": 1,
      "expect": [
        { "key": "embedding-en", "lineIncludes": "lower vector count" },
        { "key": "long-ops", "lineIncludes": "向量数量少于数据库记录数" }
      ]
    },
    {
      "query": "keyboard shortcut to open the app",
      "scenario": "cross-language-en-to-zh",
      "requiredRank": 1,
      "expect": [{ "key": "keyboard-zh", "lineIncludes": "Command + Shift + Space" }]
    },
    {
      "query": "复制命中行的按键",
      "scenario": "same-language-zh",
      "requiredRank": 1,
      "expect": [{ "key": "keyboard-zh", "lineIncludes": "按下 Tab 会复制命中行" }]
    },
    {
      "query": "签名图片链接多久过期",
      "scenario": "cross-language-zh-to-en",
      "requiredRank": 1,
      "expect": [{ "key": "image-en", "lineIncludes": "expire after twenty four hours" }]
    },
    {
      "query": "device token validity",
      "scenario": "cross-language-en-to-zh",
      "requiredRank": 1,
      "expect": [{ "key": "auth-zh", "lineIncludes": "会话默认有效期一百八十天" }]
