{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notesflash-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "INSTANCE_NAME": "NotesFlash Cloud",
    "ALLOWED_ORIGINS": "*",
    // Literal D1/FTS search remains first. Cloudflare AI Search runs only when
    // that path returns no rows; the legacy Vectorize implementation stays
    // available through the explicit "vectorize" backend switch.
    "SEMANTIC_BACKEND": "ai-search",
    "AI_SEARCH_ENABLED": "true",
    "AI_SEARCH_INSTANCE_NAME": "notesflash-search",
    // AI Search query rewrite only rewrites follow-up conversation messages,
    // not NotesFlash's independent first query. Translate zh/en explicitly.
    "AI_SEARCH_QUERY_TRANSLATION": "true",
    "AI_SEARCH_QUERY_REWRITE": "false",
    "AI_SEARCH_RERANKING": "false",
    "AI_SEARCH_MAX_RESULTS": "50",
    "AI_SEARCH_MAX_MATCHES_PER_NOTE": "3",
    "AI_SEARCH_MAX_ITEMS_PER_NOTE": "2000",
    // The settings below belong to the retained Vectorize fallback.
    // Current 768-dimension production model. Any replacement requires a fresh,
    // leakage-free calibration + frozen holdout run and a new matching index.
    "EMBEDDING_MODEL": "@cf/google/embeddinggemma-300m",
    "SEMANTIC_MIN_COSINE": "0.3",
    "SEMANTIC_RELATIVE_MIN_RATIO": "0.6",
    // Ambiguous short queries use a second contextual query view. A chunk is
    // rescued only when both views find that exact same line, so the primary
    // 0.3 threshold and the ordering of existing strong results stay intact.
    "SEMANTIC_SHORT_QUERY_RESCUE": "true",
    "SEMANTIC_SHORT_QUERY_MAX_CODEPOINTS": "24",
    "SEMANTIC_SHORT_QUERY_MAX_TOKENS": "3",
    "SEMANTIC_SHORT_QUERY_RAW_MIN_COSINE": "0.235",
    "SEMANTIC_SHORT_QUERY_EXPANDED_MIN_COSINE": "0.3",
    "SEMANTIC_MULTI_CHUNK_BONUS": "0.01",
    "SEMANTIC_MAX_BONUS_CHUNKS": "3",
    "SEMANTIC_MAX_MATCHES_PER_NOTE": "3",
    "SEMANTIC_CHUNK_TOP_K": "40",
    "SEMANTIC_CHUNK_TARGET_CHARS": "220",
    "SEMANTIC_CHUNK_MAX_CHARS": "400",
    "SEMANTIC_CHUNK_MIN_CHARS": "24",
    "SEMANTIC_CHUNK_MAX_LINES": "3",
    "SEMANTIC_CHUNK_OVERLAP_LINES": "1",
    "SEMANTIC_CHUNK_TITLE_CONTEXT": "true",
    // Narrows the highlighted range from the retrieved line window down to the
    // sentence or clause that matched, using one extra batched embedding call.
    "SEMANTIC_SPAN_REFINE": "true",
    "SEMANTIC_SPAN_MIN_CHARS": "40",
    "SEMANTIC_SPAN_MAX_CANDIDATES": "12",
    "SEMANTIC_SPAN_MAX_NOTES": "1",
    "SEMANTIC_SPAN_MIN_RATIO": "1",
    "SEMANTIC_TOP_K": "8",
    // Operator-only search lab. Keep disabled in the template: a deployment
    // inherits these values, and an enabled lab can read this instance's notes.
    "LAB_ENABLED": "false",
    "LAB_TOKEN_SHA256": "",
    "MAX_IMAGE_BYTES": "12582912",
    "SESSION_TTL_DAYS": "180",
    "TRASH_RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notesflash-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "notesflash-images"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "notesflash-vectors"
    },
    {
      "binding": "CHUNK_INDEX",
      "index_name": "notesflash-chunks"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INDEX_QUEUE",
        "queue": "notesflash-index"
      }
    ],
    "consumers": [
      {
        "queue": "notesflash-index",
        // AI Search line synchronization is paged against the per-invocation
        // internal-subrequest budget, so one Queue message owns each invocation.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/setup"]
  }
}
